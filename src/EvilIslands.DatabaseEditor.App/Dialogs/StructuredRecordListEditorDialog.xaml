<Window x:Class="EvilIslands.DatabaseEditor.App.Dialogs.StructuredRecordListEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Редактор вариантов реплики" Width="1220" Height="720"
        MinWidth="900" MinHeight="560" ResizeMode="CanResize" WindowStyle="None"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="☷" FontSize="18" Foreground="{StaticResource DatabaseAccentBrush}"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="Редактор вариантов реплики" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource RoundedButton}" Content="×"
                            Click="CloseButton_Click" MinWidth="36" Padding="8,5" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="18,16,18,12" Padding="14,11" CornerRadius="8"
                    Background="{StaticResource DatabaseSurfaceBrush}"
                    BorderBrush="{StaticResource DatabaseBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,12,0">
                        <TextBlock x:Name="AddressText" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="FieldTitleText" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Каждая строка — отдельный вариант реплики. Неизвестные служебные данные сохраняются без изменений."
                                   Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="18,0,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" ClipToBounds="True">
                    <DataGrid x:Name="EntriesGrid" BorderThickness="0" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              CanUserReorderColumns="True" SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                              FrozenColumnCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="52" />
                            <DataGridTextColumn Header="Файл" Binding="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*" MinWidth="210" />
                            <DataGridTextColumn Header="Вероятность" Binding="{Binding Probability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="115" />
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="2*" MinWidth="210" />
                            <DataGridTextColumn Header="Ключ" Binding="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="1.4*" MinWidth="150" />
                            <DataGridTextColumn x:Name="ConditionsColumn" Header="Флаги условий"
                                                Binding="{Binding Conditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="125" />
                            <DataGridTextColumn x:Name="ConditionsTextColumn" Header="Условия"
                                                Binding="{Binding ConditionsText}" IsReadOnly="True" Width="2*" MinWidth="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <TextBlock x:Name="ConditionsHelpText" Grid.Row="1" Margin="2,8,0,0"
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                           Text="Флаги условий расшифровываются справа. Значение 0 означает: без дополнительных условий." />
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,13">
                <Grid>
                    <TextBlock x:Name="ErrorText" Margin="0,0,300,0" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource RoundedButton}" Content="Отмена" Click="CancelButton_Click"
                                MinWidth="110" />
                        <Button Style="{StaticResource AccentButton}" Content="Применить варианты"
                                Click="ApplyButton_Click" MinWidth="180" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
