<Window x:Class="EvilIslands.DatabaseEditor.App.Dialogs.LongTextEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Редактор большого текста"
        Width="940"
        Height="680"
        MinWidth="640"
        MinHeight="440"
        ResizeMode="CanResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource StrongBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="▤" Foreground="{StaticResource LocalizationAccentBrush}" FontSize="19" VerticalAlignment="Center" />
                        <TextBlock Text="Редактор большого текста" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource ChromeButton}"
                            Content="×"
                            Click="CancelButton_Click"
                            ToolTip="Закрыть без применения"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource LocalizationSurfaceBrush}"
                        BorderBrush="{StaticResource LocalizationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10,6">
                    <TextBlock x:Name="AddressText"
                               FontFamily="Cascadia Mono, Consolas"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource LocalizationAccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FieldNameText" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Enter — новая строка · Ctrl+Enter — применить · Esc — отменить"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="20,0,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="EditorBox"
                         Grid.Row="0"
                         Style="{StaticResource DarkTextBox}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontSize="15"
                         Padding="14,12"
                         VerticalContentAlignment="Top"
                         TextChanged="EditorBox_TextChanged"
                         AutomationProperties.HelpText="Полный текст выбранной ячейки. Ctrl+Enter — применить, Esc — отменить." />
                <Grid Grid.Row="1" Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ErrorText"
                               Grid.Column="0"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="StatisticsText"
                               Grid.Column="1"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="14,0,0,0" />
                </Grid>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <TextBlock Text="Формат и кодировка будут проверены до записи в RES."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource RoundedButton}"
                                Content="Отмена"
                                Click="CancelButton_Click"
                                MinWidth="110" />
                        <Button x:Name="ApplyButton"
                                Style="{StaticResource AccentButton}"
                                Content="Применить"
                                Click="ApplyButton_Click"
                                MinWidth="135"
                                Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
