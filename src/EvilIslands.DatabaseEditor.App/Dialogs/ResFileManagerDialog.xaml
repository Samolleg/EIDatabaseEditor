<Window x:Class="EvilIslands.DatabaseEditor.App.Dialogs.ResFileManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Файловый менеджер RES"
        Width="1460" Height="860" MinWidth="1040" MinHeight="640"
        ResizeMode="CanResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <HierarchicalDataTemplate x:Key="FolderTemplate" ItemsSource="{Binding Children}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="▰" Foreground="{StaticResource LocalizationAccentBrush}" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#282D29" CornerRadius="8" Padding="6,2" Margin="8,0,2,0">
                    <TextBlock Text="{Binding FileCount}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                </Border>
            </Grid>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource StrongBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="17,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="▦" Foreground="{StaticResource AccentBrush}" FontSize="20" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Файловый менеджер RES" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="ArchivePathText" Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="930" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource RoundedButton}" Content="Открыть другой RES…"
                            Margin="0,0,8,0" Padding="12,6" MinHeight="0"
                            Click="OpenArchiveButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="×"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1" x:Name="MessageBorder" Margin="16,14,16,0" Padding="12,9"
                    Background="#18352D" BorderBrush="#28614F" BorderThickness="1" CornerRadius="8"
                    Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,36,0" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28"
                            Style="{StaticResource RoundedButton}" Content="×" Padding="0" MinHeight="0"
                            Click="DismissMessageButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="16,14,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="AddFilesButton" Style="{StaticResource AccentButton}" Content="＋ Файлы…"
                        Padding="12,7" Click="AddFilesButton_Click" />
                <Button x:Name="AddFolderButton" Grid.Column="1" Style="{StaticResource RoundedButton}"
                        Content="＋ Папка…" Margin="7,0,0,0" Padding="12,7" Click="AddFolderButton_Click" />
                <Button x:Name="ReplaceButton" Grid.Column="2" Style="{StaticResource RoundedButton}"
                        Content="Заменить…" Margin="7,0,0,0" Padding="12,7" Click="ReplaceButton_Click" />
                <Button x:Name="DeleteButton" Grid.Column="3" Style="{StaticResource RoundedButton}"
                        Content="Удалить" Margin="7,0,0,0" Padding="12,7" Click="DeleteButton_Click" />
                <Button x:Name="ExtractButton" Grid.Column="5" Style="{StaticResource RoundedButton}"
                        Content="Извлечь…" Padding="12,7" Click="ExtractButton_Click" />
                <Button x:Name="UndoButton" Grid.Column="6" Style="{StaticResource RoundedButton}"
                        Content="↶" ToolTip="Отменить подготовленное изменение (Ctrl+Z)"
                        Margin="7,0,0,0" Width="40" Padding="0" Click="UndoButton_Click" />
                <Button x:Name="RedoButton" Grid.Column="6" Style="{StaticResource RoundedButton}"
                        Content="↷" ToolTip="Вернуть подготовленное изменение (Ctrl+Y)"
                        Margin="50,0,0,0" Width="40" Padding="0" Click="RedoButton_Click" />
                <Grid Grid.Column="8" Margin="0,0,0,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="32,8,10,8"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Поиск по полному пути и имени файла" />
                    <TextBlock Text="⌕" Margin="10,0,0,1" FontSize="17"
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <Grid Grid.Row="3" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" MinWidth="190" MaxWidth="520" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="13,12,13,8">
                            <TextBlock Text="ПАПКИ В RES" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="FolderSummaryText" Margin="0,5,0,0"
                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                        </StackPanel>
                        <TreeView x:Name="FoldersTree" Grid.Row="1" Margin="6,0,6,8" Padding="2"
                                  Background="Transparent" BorderThickness="0"
                                  ItemTemplate="{StaticResource FolderTemplate}"
                                  SelectedItemChanged="FoldersTree_SelectedItemChanged" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                <Border Grid.Column="2" Background="{StaticResource WindowBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9"
                        ClipToBounds="True" AllowDrop="True"
                        DragEnter="FilesGrid_DragEnter" DragLeave="FilesGrid_DragLeave" Drop="FilesGrid_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" Padding="13,9"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock x:Name="CurrentFolderText" FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectionSummaryText" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </Border>
                        <DataGrid x:Name="FilesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" SelectionMode="Extended" SelectionUnit="FullRow"
                                  ClipboardCopyMode="IncludeHeader" SelectionChanged="FilesGrid_SelectionChanged"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Будет удалён">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Opacity" Value="0.62" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Добавлен">
                                            <Setter Property="Background" Value="#183528" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Заменён">
                                            <Setter Property="Background" Value="#332C1D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Binding="{Binding FileName}" Width="220" />
                                <DataGridTextColumn Header="Путь в RES" Binding="{Binding ResourceName}" Width="*" MinWidth="310" />
                                <DataGridTextColumn Header="Размер" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="110" />
                                <DataGridTextColumn Header="Смещение" Binding="{Binding OffsetText}" Width="105" />
                                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="125" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="DropHint" Grid.RowSpan="2" Background="#D9121513"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="9"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="＋" FontSize="38" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Перетащите сюда файлы или папки" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Они будут добавлены в выбранную папку RES"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,14,0,0" Padding="16,12">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ArchiveSummaryText" />
                        <TextBlock x:Name="SafetyText" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SaveCopyButton" Style="{StaticResource RoundedButton}"
                                Content="Сохранить копию RES…" MinWidth="180" Click="SaveCopyButton_Click" />
                        <Button x:Name="SaveCurrentButton" Style="{StaticResource AccentButton}"
                                Content="Сохранить в текущий RES" MinWidth="205" Margin="10,0,0,0"
                                Click="SaveCurrentButton_Click" />
                        <Button Style="{StaticResource RoundedButton}" Content="Закрыть" MinWidth="105"
                                Margin="10,0,0,0" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="BusyOverlay" Grid.Row="1" Grid.RowSpan="4" Background="#B0000000"
                    Visibility="Collapsed" CornerRadius="0,0,12,12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="320" Height="7" IsIndeterminate="True" />
                    <TextBlock x:Name="BusyText" Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Большие RES обрабатываются потоком и не загружаются целиком в память."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
