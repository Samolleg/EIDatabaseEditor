<Window x:Class="EvilIslands.DatabaseEditor.App.Dialogs.ResFileManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Файловый менеджер RES" Width="1460" Height="860" MinWidth="1040" MinHeight="640"
        ResizeMode="CanResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <HierarchicalDataTemplate x:Key="FolderTemplate" ItemsSource="{Binding Children}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="▰" Foreground="{StaticResource LocalizationAccentBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#272C29" CornerRadius="8" Padding="6,1" Margin="7,0,2,0">
                    <TextBlock Text="{Binding FileCount}" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                </Border>
            </Grid>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource DarkTreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="5,4"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#254B3D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F6F4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#203A32"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E6ECE8"/>
    </Window.Resources>
    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="17,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="▦" Foreground="{StaticResource AccentBrush}" FontSize="20"/>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ArchiveTitleText" Text="Файловый менеджер RES" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ArchivePathText" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="900"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource RoundedButton}" Content="Открыть другой RES…" Margin="0,0,8,0" Padding="12,6" MinHeight="0"
                            Click="OpenArchiveButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="×" Click="CloseButton_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" x:Name="MessageBorder" Margin="16,12,16,0" Padding="12,8"
                    Background="{StaticResource DangerSurfaceBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                <Grid><TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,36,0"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28" Style="{StaticResource RoundedButton}" Content="×" Padding="0" MinHeight="0" Click="DismissMessageButton_Click"/>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="16,12,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="UpFolderButton" Style="{StaticResource RoundedButton}" Content="↑" Width="38" Padding="0" ToolTip="На уровень выше" Click="UpFolderButton_Click"/>
                <Border Grid.Column="1" Margin="7,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7" ToolTip="Текущая папка внутри RES">
                    <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal"/>
                </Border>
                <Button x:Name="DetailsToggleButton" Grid.Column="2" Style="{StaticResource RoundedButton}" Content="Свойства" Padding="12,7" Click="DetailsToggleButton_Click"/>
            </Grid>
            <Grid Grid.Row="3" Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AddFilesButton" Style="{StaticResource AccentButton}" Content="＋ Файлы…" Padding="12,7" Click="AddFilesButton_Click"/>
                <Button x:Name="AddFolderButton" Grid.Column="1" Style="{StaticResource RoundedButton}" Content="＋ Папка…" Margin="7,0,0,0" Padding="12,7" Click="AddFolderButton_Click"/>
                <Button x:Name="ReplaceButton" Grid.Column="2" Style="{StaticResource RoundedButton}" Content="Заменить…" Margin="7,0,0,0" Padding="12,7" Click="ReplaceButton_Click"/>
                <Button x:Name="DeleteButton" Grid.Column="3" Style="{StaticResource RoundedButton}" Content="Удалить" Margin="7,0,0,0" Padding="12,7" Click="DeleteButton_Click"/>
                <Button x:Name="ExtractButton" Grid.Column="5" Style="{StaticResource RoundedButton}" Content="Извлечь…" Padding="12,7" Click="ExtractButton_Click"/>
                <Button x:Name="UndoButton" Grid.Column="6" Style="{StaticResource RoundedButton}" Content="↶" ToolTip="Отменить (Ctrl+Z)" Margin="7,0,0,0" Width="40" Padding="0" Click="UndoButton_Click"/>
                <Button x:Name="RedoButton" Grid.Column="7" Style="{StaticResource RoundedButton}" Content="↷" ToolTip="Вернуть (Ctrl+Y)" Margin="7,0,0,0" Width="40" Padding="0" Click="RedoButton_Click"/>
                <Grid Grid.Column="9">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="34,8,10,8" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по всему RES"/>
                    <TextBlock x:Name="SearchHint" Text="Поиск по всему RES…" Margin="34,0,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="⌕" Margin="10,0,0,1" FontSize="17" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
            <Grid x:Name="ManagerGrid" Grid.Row="4" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FoldersColumn" Width="250" MinWidth="190" MaxWidth="520"/><ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="*" MinWidth="380"/><ColumnDefinition x:Name="DetailsSplitterColumn" Width="7"/>
                    <ColumnDefinition x:Name="DetailsColumn" Width="310" MinWidth="0" MaxWidth="620"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="13,11,13,7"><TextBlock Text="ПАПКИ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="FolderSummaryText" Margin="0,4,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                        </StackPanel>
                        <TreeView x:Name="FoldersTree" Grid.Row="1" Margin="6,0,6,8" Padding="2" Background="Transparent" BorderThickness="0"
                                  ItemTemplate="{StaticResource FolderTemplate}" SelectedItemChanged="FoldersTree_SelectedItemChanged"/>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="GridSplitter_DragCompleted"/>
                <Border Grid.Column="2" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9"
                        ClipToBounds="True" AllowDrop="True" DragEnter="FilesGrid_DragEnter" DragLeave="FilesGrid_DragLeave" Drop="FilesGrid_Drop">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" Padding="13,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid><TextBlock x:Name="CurrentFolderText" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectionSummaryText" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}"/></Grid>
                        </Border>
                        <DataGrid x:Name="FilesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                  SelectionMode="Extended" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" SelectionChanged="FilesGrid_SelectionChanged"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Будет удалён"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/><Setter Property="Opacity" Value="0.62"/></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Добавлен"><Setter Property="Background" Value="#183528"/></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Заменён"><Setter Property="Background" Value="#332C1D"/></DataTrigger>
                                </Style.Triggers></Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Binding="{Binding FileName}" Width="*" MinWidth="220"/>
                                <DataGridTextColumn x:Name="FolderPathColumn" Header="Папка в RES" Binding="{Binding FolderPath}" Width="260" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding FileType}" Width="88"/>
                                <DataGridTextColumn Header="Размер" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="105"/>
                                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="DropHint" Grid.RowSpan="2" Background="#D9121513" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="9" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="＋" FontSize="38" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Перетащите сюда файлы или папки" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Они будут добавлены в открытую папку RES" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <GridSplitter x:Name="DetailsSplitter" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="GridSplitter_DragCompleted"/>
                <Border x:Name="DetailsPanel" Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                    <Grid Margin="15,13">
                        <StackPanel x:Name="DetailsEmptyState" VerticalAlignment="Center"><TextBlock Text="СВОЙСТВА" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Выберите файл" Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Здесь появятся полный путь, размер и состояние ресурса." Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="14,6,14,0"/>
                        </StackPanel>
                        <ScrollViewer x:Name="DetailsContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel><TextBlock Text="СВОЙСТВА ФАЙЛА" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DetailsNameText" Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="Путь в RES" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,16,0,4"/>
                                <TextBox x:Name="DetailsPathText" Style="{StaticResource DarkTextBox}" IsReadOnly="True" TextWrapping="Wrap" Padding="9,7"/>
                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Тип" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/><TextBlock x:Name="DetailsTypeText" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Размер" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/><TextBlock x:Name="DetailsSizeText" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Смещение" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,14,0,4"/><TextBlock x:Name="DetailsOffsetText"/>
                                <TextBlock Text="Состояние" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,14,0,4"/>
                                <Border x:Name="DetailsStateBadge" HorizontalAlignment="Left" Background="#282D29" CornerRadius="9" Padding="8,3"><TextBlock x:Name="DetailsStateText"/></Border>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Style="{StaticResource RoundedButton}" Content="Извлечь…" Padding="11,7" Click="ExtractButton_Click"/>
                                    <Button Style="{StaticResource RoundedButton}" Content="Заменить…" Padding="11,7" Margin="7,0,0,0" Click="ReplaceButton_Click"/></StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <Expander x:Name="ChangesExpander" Grid.Row="5" Margin="16,10,16,0" Visibility="Collapsed"
                      Expanded="ChangesExpander_StateChanged" Collapsed="ChangesExpander_StateChanged">
                <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="ИЗМЕНЕНИЯ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                    <Border Background="#30362F" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"><TextBlock x:Name="ChangesCountText" FontSize="10"/></Border>
                    <TextBlock Text="  — можно отменить отдельно до сохранения" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/></StackPanel></Expander.Header>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,7,0,0" MaxHeight="190">
                    <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" HeadersVisibility="Column" SelectionMode="Single" EnableRowVirtualization="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="125"/>
                            <DataGridTextColumn Header="Ресурс" Binding="{Binding ResourceName}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Style="{StaticResource RoundedButton}" Content="Отменить" Tag="{Binding ResourceName}" Padding="8,4" MinHeight="0" Click="RevertChangeButton_Click"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Expander>
            <Border Grid.Row="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="16,11">
                <Grid><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ArchiveSummaryText"/>
                    <TextBlock x:Name="OperationStatusText" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,3,0,0"/>
                    <TextBlock x:Name="SafetyText" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SaveCopyButton" Style="{StaticResource AccentButton}" Content="Сохранить копию RES…" MinWidth="180" Click="SaveCopyButton_Click"/>
                        <Button x:Name="SaveCurrentButton" Style="{StaticResource RoundedButton}" Content="Перезаписать текущий RES…" MinWidth="215" Margin="10,0,0,0" Click="SaveCurrentButton_Click"/>
                        <Button Style="{StaticResource RoundedButton}" Content="Закрыть" MinWidth="105" Margin="10,0,0,0" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="BusyOverlay" Grid.Row="1" Grid.RowSpan="6" Background="#B0000000" Visibility="Collapsed" CornerRadius="0,0,12,12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="320" Height="7" IsIndeterminate="True"/>
                    <TextBlock x:Name="BusyText" Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Большие RES обрабатываются потоком и не загружаются целиком в память." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
