<Window x:Class="EvilIslands.DatabaseEditor.App.Dialogs.DetachedDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Связанные данные"
        Width="1080"
        Height="620"
        MinWidth="720"
        MinHeight="420"
        ResizeMode="CanResize"
        WindowStyle="None"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                                  CornerRadius="0"
                                  GlassFrameThickness="0"
                                  ResizeBorderThickness="7"
                                  UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource StrongBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="▤" Foreground="{StaticResource LocalizationAccentBrush}" FontSize="18" />
                        <TextBlock Text="Связанные тексты и звук"
                                   Margin="9,0,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="DockButton"
                            Grid.Column="1"
                            Style="{StaticResource RoundedButton}"
                            Content="↙ Закрепить"
                            MinHeight="0"
                            Padding="10,5"
                            Margin="0,7,8,7"
                            Click="DockButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Grid.Column="2"
                            Style="{StaticResource ChromeButton}"
                            Content="—"
                            Click="MinimizeButton_Click"
                            ToolTip="Свернуть"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton"
                            Grid.Column="3"
                            Style="{StaticResource ChromeButton}"
                            Content="□"
                            Click="MaximizeButton_Click"
                            ToolTip="Развернуть"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Grid.Column="4"
                            Style="{StaticResource ChromeButton}"
                            Content="×"
                            Click="DockButton_Click"
                            ToolTip="Закрепить обратно и закрыть окно"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>

            <ContentControl x:Name="PaneHost" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
