<Window x:Class="EvilIslands.DatabaseEditor.App.Dialogs.ReferenceUsagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Где используется" Width="1180" Height="720" MinWidth="860" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                                  ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource StrongBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="17,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="⌁" Foreground="{StaticResource AccentBrush}" FontSize="20" />
                        <TextBlock Text="Где используется" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="×" Click="CloseButton_Click" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="18,14,18,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ВЫБРАННАЯ ЗАПИСЬ" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TargetTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding TargetPath}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#263A34" CornerRadius="7" Padding="10,6">
                            <TextBlock Text="{Binding ConfirmedCount, StringFormat=Точных ссылок: {0:N0}}" Foreground="#B9D7CF" />
                        </Border>
                        <Border Background="#3B3423" CornerRadius="7" Padding="10,6" Margin="8,0,0,0">
                            <TextBlock Text="{Binding StructuredCount, StringFormat=В составных значениях: {0:N0}}" Foreground="#F1D58C" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="18,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="31,8,10,8"
                             TextChanged="SearchBox_TextChanged" ToolTip="Поиск по таблице, записи, полю и значению" />
                    <TextBlock Text="⌕" Margin="10,0,0,1" FontSize="17" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <ComboBox x:Name="KindFilter" Grid.Column="1" Margin="10,0,0,0" SelectedIndex="0"
                          SelectionChanged="KindFilter_SelectionChanged">
                    <ComboBoxItem Content="Все совпадения" Tag="All" />
                    <ComboBoxItem Content="Точные ссылки" Tag="Confirmed" />
                    <ComboBoxItem Content="Составные значения" Tag="Structured" />
                </ComboBox>
            </Grid>
            <Border Grid.Row="3" Margin="18,0" CornerRadius="9" ClipToBounds="True"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <DataGrid x:Name="UsagesGrid" ItemsSource="{Binding UsagesView}" IsReadOnly="True"
                              BorderThickness="0" AutoGenerateColumns="False" SelectionMode="Single"
                              MouseDoubleClick="UsagesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип" Binding="{Binding KindText}" Width="175" />
                            <DataGridTextColumn Header="Таблица" Binding="{Binding TableTitle}" Width="180" />
                            <DataGridTextColumn Header="Запись" Binding="{Binding RecordName}" Width="220" />
                            <DataGridTextColumn Header="Поле" Binding="{Binding FieldName}" Width="190" />
                            <DataGridTemplateColumn Header="Значение" Width="*" MinWidth="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RoundedButton}" Content="Открыть" Padding="8,4"
                                                CommandParameter="{Binding}" Click="OpenUsageButton_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding EmptyStateVisibility}">
                        <TextBlock Text="⌁" FontSize="36" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Ссылки не найдены" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="Запись может использоваться только игровым кодом или скриптами вне database.res."
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                <Grid>
                    <TextBlock Text="Точные ссылки подтверждены схемой. Составные совпадения показаны отдельно и требуют проверки человеком."
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource RoundedButton}" Content="Закрыть"
                            MinWidth="110" Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
