                                                        CornerRadius="6"
                                                        Visibility="{Binding SelectedRecord.HasMissingLocalization, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Foreground="{StaticResource WarningBrush}"
                                                                       Text="Эти ключи отсутствуют в texts.res:" />
                                                            <Button x:Name="CreateMissingTextsButton"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource RoundedButton}"
                                                                    Command="{Binding AddMissingTextsCommand}"
                                                                    Content="Создать отсутствующие тексты"
                                                                    MinHeight="0"
                                                                    Padding="10,4"
                                                                    Margin="12,0,0,0" />
                                                        </Grid>
                                                        <ScrollViewer Grid.Row="1"
                                                                      MaxHeight="96"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsControl x:Name="MissingLocalizationKeysList"
                                                                          ItemsSource="{Binding SelectedRecord.MissingLocalizationKeys}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="2,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding}"
                                                                                       Foreground="{StaticResource LocalizationTextBrush}"
                                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="{Binding}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="Нет ресурса"
                                                                                       Foreground="{StaticResource WarningBrush}"
                                                                                       Margin="12,0,2,0" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                                <DataGrid x:Name="LocalizationGrid"
                                                          Grid.Row="2"
                                                          ItemsSource="{Binding SelectedRecord.RelatedTexts}"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          SelectionMode="Extended"
                                                          SelectionUnit="CellOrRowHeader"
                                                          ClipboardCopyMode="ExcludeHeader"
                                                          FontSize="14"
                                                          RowHeight="42"
                                                          ColumnHeaderHeight="42"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="{StaticResource LocalizationBorderBrush}"
                                                          VerticalGridLinesBrush="Transparent"
                                                          Visibility="{Binding SelectedRecord.HasRelatedTexts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Тип" Binding="{Binding Prefix}" Width="94" IsReadOnly="True" ElementStyle="{StaticResource LocalizationGridCellText}" HeaderStyle="{StaticResource LocalizationColumnHeaderStyle}" CellStyle="{StaticResource LocalizationEntryCellStyle}" />
                                                        <DataGridTextColumn Header="Ключ texts.res" Binding="{Binding ResourceName}" Width="220" IsReadOnly="True" ElementStyle="{StaticResource LocalizationGridCellText}" HeaderStyle="{StaticResource LocalizationColumnHeaderStyle}" CellStyle="{StaticResource LocalizationEntryCellStyle}" />
                                                        <DataGridTextColumn Header="Название RU" Binding="{Binding Title, UpdateSourceTrigger=LostFocus}" Width="220" ElementStyle="{StaticResource LocalizationGridCellText}" EditingElementStyle="{StaticResource SpreadsheetCellEditor}" HeaderStyle="{StaticResource LocalizationColumnHeaderStyle}" CellStyle="{StaticResource LocalizationEntryCellStyle}" />
                                                        <DataGridTextColumn Header="Описание RU" Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="280" ElementStyle="{StaticResource LocalizationGridDescriptionText}" EditingElementStyle="{StaticResource SpreadsheetCellEditor}" HeaderStyle="{StaticResource LocalizationColumnHeaderStyle}" CellStyle="{StaticResource LocalizationEntryCellStyle}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                        <GridSplitter x:Name="LocalizationSoundSplitter"
                                                      Grid.Row="1"
                                                      Height="7"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      ResizeDirection="Rows"
                                                      ResizeBehavior="PreviousAndNext"
                                                      ShowsPreview="False"
                                                      Background="{StaticResource LocalizationBorderBrush}"
                                                      Cursor="SizeNS"
                                                      DragCompleted="LayoutSplitter_DragCompleted"
                                                      ToolTip="Изменить соотношение русских текстов и связанных звуков" />
                                        <Border x:Name="SoundPanel"
                                                Grid.Row="2"
                                                Background="{StaticResource SoundSurfaceBrush}"
                                                BorderBrush="{StaticResource SoundBorderBrush}"
                                                BorderThickness="0,2,0,0"
                                                Padding="12,10"
                                                Visibility="{Binding SelectedRecord.HasSoundReferences, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid Margin="2,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{StaticResource SoundHeaderBrush}"
                                                                BorderBrush="{StaticResource SoundBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                Padding="7,2"
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="♪" Foreground="{StaticResource SoundAccentBrush}" FontSize="12" FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Text="Связанные звуковые файлы"
                                                                   Foreground="{StaticResource SoundTextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SelectedRecord.ResolvedSoundCount, StringFormat={} · {0:N0} найдено}"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                    <Button x:Name="SoundDetachButton"
                                                            Grid.Column="1"
                                                            Style="{StaticResource RoundedButton}"
                                                            Content="↗ Открепить"
                                                            MinHeight="0"
                                                            Padding="9,3"
                                                            Margin="10,-3,0,-1"
                                                            Click="DetailsPaneDetachButton_Click"
                                                            ToolTip="Открыть связанные тексты и звук в отдельном окне" />
                                                </Grid>
                                                <DataGrid x:Name="SoundLinksGrid"
                                                          Grid.Row="1"
                                                          ItemsSource="{Binding SelectedRecord.RelatedSounds}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          SelectionMode="Extended"
                                                          SelectionUnit="CellOrRowHeader"
                                                          ClipboardCopyMode="ExcludeHeader"
                                                          FrozenColumnCount="2"
                                                          FontSize="13"
                                                          RowHeight="36"
                                                          ColumnHeaderHeight="38"
                                                          ScrollViewer.CanContentScroll="False"
                                                          ScrollViewer.IsDeferredScrollingEnabled="False"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="{StaticResource SoundBorderBrush}"
                                                          VerticalGridLinesBrush="Transparent"
                                                          PreviewMouseWheel="SoundLinksGrid_PreviewMouseWheel">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="100" MinWidth="90" ElementStyle="{StaticResource SoundGridCellText}" HeaderStyle="{StaticResource SoundColumnHeaderStyle}" CellStyle="{StaticResource SoundEntryCellStyle}" />
                                                        <DataGridTextColumn Header="Связь / персонаж" Binding="{Binding Source}" Width="220" MinWidth="180" ElementStyle="{StaticResource SoundGridCellText}" HeaderStyle="{StaticResource SoundColumnHeaderStyle}" CellStyle="{StaticResource SoundEntryCellStyle}" />
                                                        <DataGridTextColumn Header="Текст реплики из texts.res" Binding="{Binding TranscriptText}" Width="*" MinWidth="360" ElementStyle="{StaticResource SoundGridCellText}" HeaderStyle="{StaticResource SoundColumnHeaderStyle}" CellStyle="{StaticResource SoundEntryCellStyle}" />
                                                        <DataGridTextColumn Header="Файл в RES" Binding="{Binding DisplayResourceName}" Width="360" MinWidth="260" ElementStyle="{StaticResource SoundGridCellText}" HeaderStyle="{StaticResource SoundColumnHeaderStyle}" CellStyle="{StaticResource SoundEntryCellStyle}" />
                                                        <DataGridTextColumn Header="Архив" Binding="{Binding ArchiveName}" Width="150" ElementStyle="{StaticResource SoundGridCellText}" HeaderStyle="{StaticResource SoundColumnHeaderStyle}" CellStyle="{StaticResource SoundEntryCellStyle}" />
                                                        <DataGridTextColumn Header="Формат" Binding="{Binding Format}" Width="78" ElementStyle="{StaticResource SoundGridCellText}" HeaderStyle="{StaticResource SoundColumnHeaderStyle}" CellStyle="{StaticResource SoundEntryCellStyle}" />
                                                        <DataGridTextColumn Header="Размер" Binding="{Binding LengthText}" Width="92" ElementStyle="{StaticResource SoundGridCellText}" HeaderStyle="{StaticResource SoundColumnHeaderStyle}" CellStyle="{StaticResource SoundEntryCellStyle}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                        </Grid>
                                    </Grid>
                                    <Grid x:Name="BriefingWorkspace"
                                          Visibility="{Binding IsBriefingsTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="BriefingScenesColumn" Width="220" MinWidth="170" MaxWidth="520" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition x:Name="BriefingTimelineColumn" Width="460" MinWidth="300" MaxWidth="900" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" MinWidth="350" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#121817"
                                                BorderBrush="{StaticResource StrongBorderBrush}"
                                                BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Margin="14,12,12,10">
                                                    <TextBlock Text="Брифинги" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="Выберите сцену разговора"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <ListBox Grid.Row="1"
                                                         ItemsSource="{Binding RecordsView}"
                                                         SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         VirtualizingPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem"
                                                               BasedOn="{StaticResource DarkListBoxItem}">
                                                            <Setter Property="Padding" Value="12,9" />
                                                            <Setter Property="Margin" Value="5,2" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#23463B" />
                                                                    <Setter Property="Foreground" Value="#F4FFF9" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding LocalizationTitle}"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               FontSize="11"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1"
                                                                        Background="#26322F"
                                                                        CornerRadius="9"
                                                                        Padding="7,2"
                                                                        VerticalAlignment="Center"
                                                                        Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding BriefingPhraseCount}"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource AccentBrush}" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <GridSplitter x:Name="BriefingScenesSplitter"
                                                      Grid.Column="1"
                                                      Width="7"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      ResizeDirection="Columns"
                                                      ResizeBehavior="PreviousAndNext"
                                                      ShowsPreview="False"
                                                      Background="{StaticResource StrongBorderBrush}"
                                                      Cursor="SizeWE"
                                                      DragCompleted="LayoutSplitter_DragCompleted"
                                                      ToolTip="Изменить ширину списка брифингов" />

                                        <Border Grid.Column="2"
                                                Background="#151B19"
                                                BorderBrush="{StaticResource StrongBorderBrush}"
                                                BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid Margin="14,11,12,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Сценарий брифинга" FontSize="15" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding BriefingWorkspaceSummary}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              Content="Только проблемы"
                                                              IsChecked="{Binding ShowOnlyBriefingProblems}"
                                                              VerticalAlignment="Center"
                                                              Foreground="{StaticResource TextBrush}" />
                                                </Grid>
                                                <DataGrid x:Name="BriefingPhrasesGrid"
                                                          Grid.Row="1"
                                                          ItemsSource="{Binding FilteredBriefingPhrases}"
                                                          SelectedItem="{Binding SelectedBriefingPhrase, Mode=TwoWay}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          SelectionMode="Single"
                                                          SelectionUnit="FullRow"
                                                          RowHeight="68"
                                                          ColumnHeaderHeight="36"
                                                          BorderThickness="0"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
                                                          ScrollViewer.CanContentScroll="False">
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                                    <Setter Property="Background" Value="#342D1D" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#245844" />
                                                                    <Setter Property="Foreground" Value="#F4FFF9" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Шаг" Binding="{Binding SequenceNumber}" Width="48" ElementStyle="{StaticResource CenteredIndexTextStyle}" />
                                                        <DataGridTemplateColumn Header="Событие"
                                                                                Width="*"
                                                                                MinWidth="300"
                                                                                ClipboardContentBinding="{Binding DisplayText}">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="8,4">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding StatusText}"
                                                                                       Foreground="{StaticResource WarningBrush}"
                                                                                       FontSize="10"
                                                                                       Margin="8,0,0,0" />
                                                                        </Grid>
                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="{Binding DisplayText}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding DisplayText}" />
                                                                        <TextBlock Grid.Row="2"
                                                                                   Text="{Binding DisplayDetails}"
                                                                                   Foreground="{StaticResource SoundAccentBrush}"
                                                                                   FontSize="10"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>

                                        <GridSplitter x:Name="BriefingTimelineSplitter"
                                                      Grid.Column="3"
                                                      Width="7"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      ResizeDirection="Columns"
                                                      ResizeBehavior="PreviousAndNext"
                                                      ShowsPreview="False"
                                                      Background="{StaticResource StrongBorderBrush}"
                                                      Cursor="SizeWE"
                                                      DragCompleted="LayoutSplitter_DragCompleted"
                                                      ToolTip="Изменить ширину сценария брифинга" />

                                        <Border Grid.Column="4" Background="#111615" Padding="18,14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding BriefingEditorTitle}" FontSize="18" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SelectedBriefingPhrase.StatusText, TargetNullValue=Текст хранится в связанном BRIEFING-ресурсе texts.res}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource RoundedButton}"
                                                            Command="{Binding NewBriefingPhraseCommand}"
                                                            Content="＋ Реплика"
                                                            Padding="11,6" />
                                                    <WrapPanel Grid.Row="1"
                                                               Grid.ColumnSpan="2"
                                                               Margin="0,12,0,0">
                                                        <TextBlock Text="Добавить после выбранного:"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,9,6" />
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding AddBriefingEventCommand}" CommandParameter="Camera" Content="＋ Камера" Padding="9,5" Margin="0,0,6,6" />
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding AddBriefingEventCommand}" CommandParameter="Animation" Content="＋ Анимация" Padding="9,5" Margin="0,0,6,6" />
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding AddBriefingEventCommand}" CommandParameter="Thought" Content="＋ Мысль" Padding="9,5" Margin="0,0,6,6" />
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding AddBriefingEventCommand}" CommandParameter="Show" Content="＋ Показать" Padding="9,5" Margin="0,0,6,6" />
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding AddBriefingEventCommand}" CommandParameter="Hide" Content="＋ Скрыть" Padding="9,5" Margin="0,0,6,6" />
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding AddBriefingEventCommand}" CommandParameter="Description" Content="＋ Пометка" Padding="9,5" Margin="0,0,6,6" />
                                                    </WrapPanel>
                                                    <StackPanel Grid.Row="2"
                                                                Grid.ColumnSpan="2"
                                                                Orientation="Horizontal"
                                                                Margin="0,4,0,0">
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding MoveBriefingEventUpCommand}" Content="↑ Выше" Padding="9,5" Margin="0,0,6,0" ToolTip="Переместить выбранное событие на один шаг выше" />
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding MoveBriefingEventDownCommand}" Content="↓ Ниже" Padding="9,5" Margin="0,0,6,0" ToolTip="Переместить выбранное событие на один шаг ниже" />
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding DuplicateBriefingEventCommand}" Content="⧉ Дублировать" Padding="9,5" Margin="0,0,6,0" ToolTip="Создать копию выбранного события сразу после него" />
                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding DeleteBriefingEventCommand}" Content="Удалить событие" Padding="9,5" ToolTip="Удалить выбранное событие; Ctrl+Z вернёт его" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Grid.Row="1"
                                                        Background="#342D1D"
                                                        BorderBrush="{StaticResource WarningBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="10,7"
                                                        Margin="0,12,0,0"
                                                        Visibility="{Binding SelectedBriefingPhrase.HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Что требует внимания"
                                                                   Foreground="{StaticResource WarningBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SelectedBriefingPhrase.ProblemSummary}"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Grid Grid.Row="2" Margin="0,14,0,0">
                                                    <Grid Visibility="{Binding IsPhraseBriefingEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Персонаж" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,5" />
                                                            <TextBox Style="{StaticResource DarkTextBox}"
                                                                     Text="{Binding BriefingDraftSpeaker, UpdateSourceTrigger=PropertyChanged}"
                                                                     Padding="10,7" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="Текст реплики"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Margin="2,12,0,5" />
                                                        <TextBox Grid.Row="2"
                                                                 Style="{StaticResource DarkTextBox}"
                                                                 Text="{Binding BriefingDraftText, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 HorizontalScrollBarVisibility="Disabled"
                                                                 Padding="12,10"
                                                                 FontSize="15"
                                                                 VerticalContentAlignment="Top" />
                                                        <Border Grid.Row="3"
                                                                Background="{StaticResource SoundSurfaceBrush}"
                                                                BorderBrush="{StaticResource SoundBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                Padding="10,8"
                                                                Margin="0,12,0,0">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Аудиофайл" Foreground="{StaticResource SoundAccentBrush}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding SelectedBriefingPhrase.AudioName, TargetNullValue=Аудио не выбрано}"
                                                                                   Foreground="{StaticResource SoundTextBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding SelectedBriefingPhrase.AudioName}" />
                                                                    </StackPanel>
                                                                    <WrapPanel Grid.Column="1" Margin="12,0,0,0">
                                                                        <Button x:Name="ImportBriefingAudioButton" Style="{StaticResource RoundedButton}" Command="{Binding ImportBriefingAudioCommand}" Content="＋ MP3/WAV…" Padding="10,5" Margin="0,0,6,0" ToolTip="Подготовить добавление или замену аудио; исходный RES не изменяется" />
                                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding PlayBriefingAudioCommand}" Content="▶ Слушать" Padding="10,5" Margin="0,0,6,0" />
                                                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding StopBriefingAudioCommand}" Content="■" Padding="10,5" ToolTip="Остановить" />
                                                                    </WrapPanel>
                                                                </Grid>
                                                                <Border x:Name="PendingSoundEditPanel"
                                                                        Background="#16241F"
                                                                        BorderBrush="{StaticResource AccentBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="9,7"
                                                                        Margin="0,9,0,0"
                                                                        Visibility="{Binding HasPendingSoundEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding PendingSoundEdit.ActionText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding PendingSoundEdit.PhraseText}" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                                                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PendingSoundEdit.ResourceName}">
                                                                                <Run Text="{Binding PendingSoundEdit.SourceFileName, Mode=OneWay}" />
                                                                                <Run Text="  →  " />
                                                                                <Run Text="{Binding PendingSoundEdit.ArchiveName, Mode=OneWay}" />
                                                                                <Run Text=" / " />
                                                                                <Run Text="{Binding PendingSoundEdit.ResourceName, Mode=OneWay}" />
                                                                                <Run Text="  ·  " />
                                                                                <Run Text="{Binding PendingSoundEdit.LengthText, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                            <TextBlock Text="Можно безопасно обновить текущий RES с .bak-копией или сохранить отдельную копию."
                                                                                       Foreground="{StaticResource SoundAccentBrush}"
                                                                                       FontSize="11"
                                                                                       Margin="0,3,0,0" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                            <Button x:Name="SavePendingSoundCurrentButton" Style="{StaticResource AccentButton}" Command="{Binding SavePendingSoundCurrentCommand}" Content="Сохранить в текущий RES" Padding="11,6" Margin="0,0,6,0" />
                                                                            <Button x:Name="SavePendingSoundCopyButton" Style="{StaticResource RoundedButton}" Command="{Binding SavePendingSoundCopyCommand}" Content="Сохранить копию…" Padding="11,6" Margin="0,0,6,0" />
                                                                            <Button x:Name="CancelPendingSoundEditButton" Style="{StaticResource RoundedButton}" Command="{Binding CancelPendingSoundEditCommand}" Content="Отменить" Padding="10,6" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <Grid Visibility="{Binding IsCommandBriefingEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Border Background="#19231F"
                                                                BorderBrush="#345046"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="12,10">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding SelectedBriefingPhrase.EventTypeText}"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding SelectedBriefingPhrase.DisplayDetails}"
                                                                           FontFamily="Cascadia Mono, Consolas"
                                                                           Margin="0,5,0,0"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding BriefingCommandFieldLabel}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Margin="2,16,0,5" />
                                                        <TextBox Grid.Row="2"
                                                                 Style="{StaticResource DarkTextBox}"
                                                                 Text="{Binding BriefingDraftArguments, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding BriefingCommandHasArguments}"
                                                                 AcceptsReturn="False"
                                                                 Padding="12,10"
                                                                 FontSize="15" />
                                                        <Border Grid.Row="3"
                                                                Background="#171D1B"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="14"
                                                                Margin="0,14,0,0"
                                                                VerticalAlignment="Top">
                                                            <StackPanel>
                                                                <TextBlock Text="Что делает это событие" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding BriefingCommandHelp}"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,7,0,0" />
                                                                <TextBlock Text="Команда останется в том же месте сценария. Меняются только её параметры."
                                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,10,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>

                                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource RoundedButton}" Command="{Binding PreviousBriefingPhraseCommand}" Content="← Предыдущее" Padding="10,6" Margin="0,0,7,0" />
                                                    <Button Grid.Column="1" Style="{StaticResource RoundedButton}" Command="{Binding NextBriefingPhraseCommand}" Content="Следующее →" Padding="10,6" />
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource AccentButton}"
                                                            Command="{Binding ApplyBriefingPhraseCommand}"
                                                            Content="✓ Применить"
                                                            Padding="14,7" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="5" Margin="2,7,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedRecord.Path, TargetNullValue=Выберите клетки · Ctrl+C — копировать · Ctrl+V — вставить}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Shift/Ctrl — выделить · Ctrl+C/V — обмен с Excel · Ctrl+Insert — новая строка из выбранной · F2 — изменить"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <!-- Changes -->
                            <Grid Margin="22,18,22,22"
                                  Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Changes}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#263A34" BorderBrush="#36564D" BorderThickness="1" CornerRadius="9" Padding="12,9">
                                    <TextBlock Text="Список формируется относительно последнего сохранённого состояния. Ctrl+S записывает изменения с автоматической .bak-копией." Foreground="#B9D7CF" />
                                </Border>
                                <Border Grid.Row="2" CornerRadius="10" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <DataGrid x:Name="ChangesGrid" ItemsSource="{Binding Changes}" BorderThickness="0" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Запись" Binding="{Binding RecordName}" Width="15*" MinWidth="150" />
                                                <DataGridTextColumn Header="Поле" Binding="{Binding FieldName}" Width="12*" MinWidth="130" />
                                                <DataGridTextColumn Header="Было" Binding="{Binding OriginalValue}" Width="*" MinWidth="120" />
                                                <DataGridTextColumn Header="Стало" Binding="{Binding NewValue}" Width="*" MinWidth="120" />
                                                <DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="15*" MinWidth="180" />
                                                <DataGridTemplateColumn Header="" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource RoundedButton}"
                                                                    Padding="9,4"
                                                                    MinHeight="28"
                                                                    Content="{Binding ActionText}"
                                                                    Command="{Binding DataContext.RevertChangeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding HasChanges, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <TextBlock Text="✓" FontSize="30" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Изменений пока нет" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                            <TextBlock Text="Исходный файл и рабочая модель совпадают." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Validation -->
                            <Grid Margin="22,18,22,22"
                                  Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Validation}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#452727" CornerRadius="8" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="●" Foreground="#FF8B8B" FontSize="9" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding ErrorCount, StringFormat={}{0} ошибок}" Foreground="#FFB4B4" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#403821" CornerRadius="8" Padding="12,7" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="●" Foreground="#E7C45A" FontSize="9" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding WarningCount, StringFormat={}{0} предупреждений}" Foreground="#F1D58C" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#1D2A26" CornerRadius="8" Padding="12,7" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DiagnosticFilterSummary}" Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                    <Button Grid.Column="4" Style="{StaticResource RoundedButton}" Command="{Binding RefreshValidationCommand}" Content="↻  Проверить снова  ·  F5" />
                                </Grid>

                                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="250" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="ValidationSearchBox"
                                                     Text="{Binding DiagnosticSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Поиск по причине, месту, сообщению или техническому коду"
                                                     Padding="32,8,10,8" />
                                            <TextBlock Text="⌕" Foreground="{StaticResource MutedTextBrush}" FontSize="17" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        </Grid>
                                        <ComboBox x:Name="ValidationSeverityFilter"
                                                  Grid.Column="1"
                                                  Margin="10,0,0,0"
                                                  ItemsSource="{Binding DiagnosticSeverityOptions}"
                                                  SelectedItem="{Binding SelectedDiagnosticSeverityFilter}" />
                                        <ComboBox x:Name="ValidationDomainFilter"
                                                  Grid.Column="2"
                                                  Margin="10,0,0,0"
                                                  ItemsSource="{Binding DiagnosticDomainOptions}"
                                                  SelectedItem="{Binding SelectedDiagnosticDomainFilter}" />
                                        <CheckBox x:Name="ValidationBlockingFilter"
                                                  Grid.Row="1"
                                                  Grid.Column="0"
                                                  Margin="2,10,0,0"
                                                  IsChecked="{Binding ShowOnlyBlockingDiagnostics}"
                                                  Content="Только блокирующие"
                                                  VerticalAlignment="Center" />
                                        <Button x:Name="ValidationClearFiltersButton"
                                                Grid.Column="4"
                                                Style="{StaticResource RoundedButton}"
                                                Command="{Binding ClearDiagnosticFiltersCommand}"
                                                Content="Сбросить фильтры"
                                                Margin="12,0,0,0" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ValidationCategoriesColumn" Width="260" MinWidth="210" MaxWidth="420" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" MinWidth="360" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition x:Name="ValidationDetailsColumn" Width="430" MinWidth="320" MaxWidth="760" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="0" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Padding="14,13,14,11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock Text="ВИДЫ ПРОБЛЕМ" Style="{StaticResource MutedLabel}" />
                                                    <TextBlock Text="Выберите причину" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ListBox x:Name="ValidationCategoriesList"
                                                     Grid.Row="1"
                                                     ItemsSource="{Binding DiagnosticCategories}"
                                                     SelectedItem="{Binding SelectedDiagnosticCategory}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="7,4" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="CategoryBorder"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="Transparent"
                                                                            BorderThickness="1"
                                                                            CornerRadius="7"
                                                                            Padding="10,9">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CategoryBorder" Property="Background" Value="#1D2925" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="CategoryBorder" Property="Background" Value="#234137" />
                                                                            <Setter TargetName="CategoryBorder" Property="BorderBrush" Value="#3B745F" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="●" FontSize="8" Foreground="{Binding Severity, Converter={StaticResource SeverityBrushConverter}}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding SeverityText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="#2A3833" CornerRadius="9" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Count}" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>

                                    <GridSplitter Grid.Column="1"
                                                  Width="8"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Background="Transparent"
                                                  DragCompleted="LayoutSplitter_DragCompleted"
                                                  ToolTip="Изменить ширину списка видов проблем" />

                                    <Border Grid.Column="2" CornerRadius="10" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Padding="14,11" Background="#171D1B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedDiagnosticCategoryTitle}" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Text="Записи выбранного вида" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DiagnosticFilterSummary}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <DataGrid x:Name="ValidationGrid"
                                                  Grid.Row="1"
                                                  ItemsSource="{Binding DiagnosticsView}"
                                                  SelectedItem="{Binding SelectedDiagnostic}"
                                                  BorderThickness="0"
                                                  IsReadOnly="True"
                                                  RowHeight="54"
                                                  MouseDoubleClick="ValidationGrid_MouseDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="32" CanUserSort="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="●" FontSize="9" Foreground="{Binding Severity, Converter={StaticResource SeverityBrushConverter}}" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Где находится" Width="1.35*" MinWidth="220" SortMemberPath="Place" ClipboardContentBinding="{Binding Place}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Place}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" ToolTip="{Binding Detail}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Что обнаружено" Width="2*" MinWidth="300" SortMemberPath="Message" ClipboardContentBinding="{Binding Message}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" ToolTip="{Binding Message}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FilteredDiagnosticCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="✓" FontSize="34" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding DiagnosticEmptyTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                                            <TextBlock Text="{Binding DiagnosticEmptyHint}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        </Grid>
                                    </Border>

                                    <GridSplitter Grid.Column="3"
                                                  Width="8"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Background="Transparent"
                                                  DragCompleted="LayoutSplitter_DragCompleted"
                                                  ToolTip="Изменить ширину панели подробностей" />

                                    <Border Grid.Column="4" Style="{StaticResource SurfaceCard}" Padding="16">
                                        <Grid>
                                            <StackPanel Visibility="{Binding HasSelectedDiagnostic, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="☑" FontSize="30" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Выберите проблему" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                                                <TextBlock Text="Здесь появятся полное сообщение и место в базе." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <Grid Visibility="{Binding HasSelectedDiagnostic, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="ПОДРОБНОСТИ" Style="{StaticResource MutedLabel}" />
                                                        <TextBlock Text="{Binding SelectedDiagnostic.CategoryText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                            <TextBlock Text="●" FontSize="9" Foreground="{Binding SelectedDiagnostic.Severity, Converter={StaticResource SeverityBrushConverter}}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding SelectedDiagnostic.SeverityText}" />
                                                            <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SelectedDiagnostic.ImpactText}" Foreground="{StaticResource MutedTextBrush}" />
                                                        </StackPanel>

                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="Что обнаружено" Style="{StaticResource MutedLabel}" />
                                                                <TextBlock Text="{Binding SelectedDiagnostic.Message}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="#191F1D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="МЕСТО В БАЗЕ" Style="{StaticResource MutedLabel}" />
                                                                <TextBlock Text="{Binding SelectedDiagnostic.TableTitle}" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding SelectedDiagnostic.RecordTitle, StringFormat=Запись: {0}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding SelectedDiagnostic.FieldTitle, StringFormat=Поле: {0}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Expander Header="Технические сведения" Margin="0,14,0,0">
                                                            <StackPanel Margin="0,8,0,0">
                                                                <TextBlock Text="{Binding SelectedDiagnostic.Code}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding SelectedDiagnostic.Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                            </StackPanel>
                                                        </Expander>
                                                    </StackPanel>
                                                </ScrollViewer>
                                                <Button Grid.Row="1"
                                                        Style="{StaticResource AccentButton}"
                                                        Command="{Binding NavigateToDiagnosticCommand}"
                                                        CommandParameter="{Binding SelectedDiagnostic}"
                                                        Content="Открыть место в таблице"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,14,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Busy overlay -->
                        <Border Background="#B8171717" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="410" Style="{StaticResource SurfaceCard}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="{Binding BusyText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                                    <ProgressBar Height="4" IsIndeterminate="True" Margin="0,18,0,0" Foreground="{StaticResource AccentBrush}" Background="#1D1D1D" />
                                    <Button Style="{StaticResource RoundedButton}" Command="{Binding CancelOperationCommand}" Content="Отменить" HorizontalAlignment="Center" Margin="0,18,0,0" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Background="#1B1B1B" BorderBrush="#303030" BorderThickness="0,1,0,0" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="●" FontSize="7" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="7,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ChangeCount, StringFormat={}{0} изм.}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock Text="   ·   Preview" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
