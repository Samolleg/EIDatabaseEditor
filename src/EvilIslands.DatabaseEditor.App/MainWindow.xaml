<Window x:Class="EvilIslands.DatabaseEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Редактор БД от Атамана — Preview"
        Icon="/EvilIslands.DatabaseEditor;component/Assets/AppIcon.ico"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveCopyCommand}" />
        <KeyBinding Key="Insert" Modifiers="Control" Command="{Binding AppendRecordCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshValidationCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="FormulaTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FormulaInputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FormulaInputBorder" Property="Background" Value="#1D2723" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Setter Property="CaretBrush" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormulaActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FormulaActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FormulaActionBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FormulaActionBorder" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FormulaActionBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SpreadsheetColumnHeaderTemplate">
            <StackPanel Margin="0,4"
                        VerticalAlignment="Center"
                        ToolTip="{Binding HeaderToolTip}"
                        ToolTipService.ShowDuration="12000">
                <TextBlock Text="{Binding Title}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}"
                           Foreground="{StaticResource SubtleTextBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SpreadsheetColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource DatabaseHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DatabaseTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DatabaseBorderBrush}" />
        </Style>

        <Style x:Key="DatabaseIdentityColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource SpreadsheetColumnHeaderStyle}">
            <Setter Property="Background" Value="{StaticResource DatabaseHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DatabaseAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DatabaseBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,1,2" />
        </Style>

        <Style x:Key="TechnicalColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource SpreadsheetColumnHeaderStyle}">
            <Setter Property="Background" Value="{StaticResource TechnicalHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TechnicalAccentBrush}" />
            <Setter Property="BorderBrush" Value="#665331" />
        </Style>

        <Style x:Key="LocalizationColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="{StaticResource LocalizationHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource LocalizationTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LocalizationBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LocalizationEntryCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{StaticResource LocalizationSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource LocalizationTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ModifiedSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SpreadsheetSelectionBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SoundColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="{StaticResource SoundHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SoundTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SoundBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SoundEntryCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{StaticResource SoundSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SoundTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsResolved}" Value="False">
                    <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPreferred}" Value="False">
                    <Setter Property="Opacity" Value="0.65" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SpreadsheetSelectionBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource SoundAccentBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SoundGridCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoundTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        <Style x:Key="LocalizationGridCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LocalizationTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        <Style x:Key="LocalizationGridDescriptionText"
               TargetType="TextBlock"
               BasedOn="{StaticResource LocalizationGridCellText}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="IndexColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="{StaticResource SidebarBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="IndexColumnCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#14171A" />
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="CenteredIndexTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="RecordIndexTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CenteredIndexTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDiagnostics}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasBlockingDiagnostics}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpreadsheetCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        <Style x:Key="SpreadsheetCellEditor"
               TargetType="TextBox"
               BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Background" Value="#111417" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#356F62" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

    </Window.Resources>

    <Border x:Name="MainRoot"
            Background="{StaticResource WindowBrush}"
            BorderBrush="#080A0D"
            BorderThickness="1">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="InterfaceScaleTransform" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom dark title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderSidebarColumn" Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#0A0C0A" ClipToBounds="True">
                            <Image x:Name="BrandIcon"
                                   Source="/EvilIslands.DatabaseEditor;component/Assets/AppIcon.png"
                                   Stretch="UniformToFill"
                                   SnapsToDevicePixels="True" />
                        </Border>
                        <TextBlock Text="Редактор БД от Атамана" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="Редактор БД от Атамана" FontWeight="SemiBold" />
                        <TextBlock Text="  —  Preview" Foreground="{StaticResource MutedTextBrush}" />
                        <Border Margin="14,0,0,0" Padding="9,4" CornerRadius="7" Background="#17362F"
                                BorderBrush="#285D50" BorderThickness="1"
                                Visibility="{Binding HasDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" FontSize="8" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="  источник защищён" FontSize="11" Foreground="#B9D7CF" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ResetLayoutButton"
                                Style="{StaticResource RoundedButton}"
                                Content="Сбросить макет"
                                MinHeight="0"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                Click="ResetLayoutButton_Click"
                                ToolTip="После подтверждения вернуть стандартные размеры панелей и вспомогательных окон" />
                        <Border x:Name="InterfaceScaleControl"
                                Margin="0,0,8,0"
                                Padding="3"
                                CornerRadius="7"
                                Background="#1A1E1C"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                ToolTip="Масштаб интерфейса. Настройка сохраняется для следующих запусков.">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ScaleDownButton"
                                        Style="{StaticResource RoundedButton}"
                                        Content="−"
                                        Width="28"
                                        Height="26"
                                        MinHeight="0"
                                        Padding="0"
                                        Margin="0"
                                        Click="ScaleDownButton_Click"
                                        ToolTip="Уменьшить интерфейс" />
                                <TextBlock x:Name="InterfaceScaleText"
                                           Text="100%"
                                           Width="48"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <Button x:Name="ScaleUpButton"
                                        Style="{StaticResource RoundedButton}"
                                        Content="＋"
                                        Width="28"
                                        Height="26"
                                        MinHeight="0"
                                        Padding="0"
                                        Margin="0"
                                        Click="ScaleUpButton_Click"
                                        ToolTip="Увеличить интерфейс" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource ChromeButton}" ToolTip="Свернуть" Click="MinimizeButton_Click" Content="—" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" ToolTip="Развернуть" Click="MaximizeButton_Click" Content="□" />
                        <Button Style="{StaticResource ChromeButton}" ToolTip="Закрыть" Click="CloseButton_Click" Content="×">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#C42B1C" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="220" MaxWidth="520" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="10,14,10,8">
                            <Button Style="{StaticResource AccentButton}"
                                    Command="{Binding OpenCommand}"
                                    ToolTip="Открыть database.res (Ctrl+O)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" FontSize="17" Foreground="White" VerticalAlignment="Center" />
                                    <TextBlock Text="  Открыть database.res…" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenResFileManagerButton"
                                    Style="{StaticResource RoundedButton}"
                                    Content="▦  Открыть любой RES как архив…"
                                    ToolTip="Посмотреть, извлечь, добавить, заменить или убрать файлы внутри любого RES"
                                    Margin="0,8,0,0"
                                    Padding="12,8"
                                    Click="OpenResFileManagerButton_Click" />
                            <Button Style="{StaticResource RoundedButton}"
                                    Command="{Binding AttachTextsCommand}"
                                    Content="{Binding AttachTextsButtonText}"
                                    ToolTip="{Binding TextsPath}"
                                    Margin="0,8,0,0"
                                    Padding="12,8" />
                            <Button Style="{StaticResource RoundedButton}"
                                    Command="{Binding AttachSoundsCommand}"
                                    Content="{Binding AttachSoundsButtonText}"
                                    ToolTip="{Binding SoundArchivePaths}"
                                    Margin="0,8,0,0"
                                    Padding="12,8" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,4,0,8">
                                <TextBlock Text="ОБЗОР" Margin="18,8,12,5" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                <RadioButton DataContext="{Binding OverviewNavigationItem}"
                                             Style="{StaticResource SidebarItem}"
                                             GroupName="WorkspaceNavigation"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             IsEnabled="{Binding IsEnabled}"
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontSize="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="9,0,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                    </Grid>
                                </RadioButton>

                                <TextBlock Text="ИГРОВЫЕ ДАННЫЕ" Margin="18,15,12,6" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                <RadioButton DataContext="{Binding TextsNavigationItem}"
                                             Style="{StaticResource SidebarItem}"
                                             GroupName="WorkspaceNavigation"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             IsEnabled="{Binding IsEnabled}"
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}"
                                             ToolTip="Полное содержимое подключённого texts.res">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="9,0,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                        <Border Grid.Column="2" Background="#303030" CornerRadius="7" Padding="7,2" MinWidth="36">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </RadioButton>
                                <ItemsControl ItemsSource="{Binding Databases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsEnabled}"
                                                      Foreground="{StaticResource TextBrush}"
                                                      Margin="8,1,8,2">
                                                <Expander.Header>
                                                    <Grid Width="226" Margin="4,7,2,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding ResourceName}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                                                <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           ToolTip="{Binding StatusToolTip}"
                                                                           FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEditable}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="#303030" CornerRadius="7" Padding="7,3" MinWidth="32" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RecordCount, StringFormat=N0}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Tables}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <RadioButton Style="{StaticResource SidebarItem}"
                                                                         Padding="10,7"
                                                                         Margin="22,0,0,1"
                                                                         GroupName="WorkspaceNavigation"
                                                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                         IsEnabled="{Binding IsEnabled}"
                                                                         Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         CommandParameter="{Binding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="●" FontSize="7" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsEditable}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="7,0,8,0" FontSize="13" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding RecordCount, StringFormat=N0}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                                                </Grid>
                                                            </RadioButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="#303030" Margin="14,14,14,5" />
                                <TextBlock Text="СЛУЖЕБНОЕ" Margin="18,8,12,5" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                <ItemsControl ItemsSource="{Binding ServiceNavigationItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource SidebarItem}"
                                                         GroupName="WorkspaceNavigation"
                                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                         IsEnabled="{Binding IsEnabled}"
                                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" FontSize="15" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="9,0,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                                    <Border Grid.Column="2" Background="#303030" CornerRadius="7" Padding="7,2" MinWidth="24">
                                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Margin="10,8,10,12" Padding="12" Background="#202020" BorderBrush="#343434" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#263A34">
                                        <TextBlock Text="▣" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Редактирование" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding SourceFileName}" Margin="0,9,0,0" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                                <TextBlock Grid.Row="2" Text="Сохранение с резервной копией" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter x:Name="SidebarSplitter"
                              Grid.Column="1"
                              Width="7"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False"
                              Background="{StaticResource StrongBorderBrush}"
                              Cursor="SizeWE"
                              DragDelta="SidebarSplitter_DragDelta"
                              DragCompleted="LayoutSplitter_DragCompleted"
                              ToolTip="Изменить ширину навигации" />

                <!-- Workspace -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#191C20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BreadcrumbText}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageHeading}" />
                                <TextBlock Text="{Binding PageSubtitle}" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button Style="{StaticResource SmallIconButton}" Command="{Binding UndoCommand}" Content="↶" ToolTip="Отменить (Ctrl+Z)" />
                                <Button Style="{StaticResource SmallIconButton}" Command="{Binding RedoCommand}" Content="↷" ToolTip="Повторить (Ctrl+Y)" Margin="6,0,0,0" />
                                <Button Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" Margin="10,0,0,0" ToolTip="Сохранить текущий файл (Ctrl+S)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Foreground="White" />
                                        <TextBlock Text="Сохранить" Foreground="White" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RoundedButton}" Command="{Binding SaveCopyCommand}" Margin="10,0,0,0" ToolTip="Новая проверенная копия (Ctrl+Shift+S)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⇩" />
                                        <TextBlock Text="Сохранить копию…" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="18,10,18,0"
                            Padding="12,9"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#17362F" />
                                <Setter Property="BorderBrush" Value="#2C6B59" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotificationIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="#7A3D47" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding NotificationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SmallIconButton}" Command="{Binding DismissNotificationCommand}" Content="×" Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <!-- Welcome state -->
                        <Grid Visibility="{Binding HasDocument, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel Width="590" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="68" Height="68" CornerRadius="20" Background="#263A34" HorizontalAlignment="Center">
                                    <TextBlock Text="EI" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Безопасный редактор database.res" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                                <TextBlock Text="Откройте database.res — все распознанные таблицы сразу будут доступны для редактирования. Приложение ничего не устанавливает в игру автоматически." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="14" LineHeight="22" Margin="0,12,0,0" />
                                <Button Style="{StaticResource AccentButton}" Command="{Binding OpenCommand}" Content="Открыть database.res…" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="20,10" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <TextBlock Text="▣  автоматическая .bak-копия" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="     •     редактирование включено сразу" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Loaded workspace pages -->
                        <Grid Visibility="{Binding HasDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Overview -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Overview}">
                                <StackPanel Margin="22,20,22,28" MaxWidth="1200">
                                    <UniformGrid Columns="4" Margin="0,0,0,16">
                                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="БАЗЫ ДАННЫХ" Style="{StaticResource MutedLabel}" />
                                                <TextBlock Text="{Binding DatabaseCount, StringFormat=N0}" Style="{StaticResource MetricValue}" />
                                                <TextBlock Text="структурных ресурсов" Style="{StaticResource MutedLabel}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SurfaceCard}" Margin="4,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="ТАБЛИЦЫ" Style="{StaticResource MutedLabel}" />
                                                <TextBlock Text="{Binding TableCount, StringFormat=N0}" Style="{StaticResource MetricValue}" />
                                                <TextBlock Text="отдельных представлений" Style="{StaticResource MutedLabel}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SurfaceCard}" Margin="4,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="ЗАПИСИ" Style="{StaticResource MutedLabel}" />
                                                <TextBlock Text="{Binding RecordCount, StringFormat=N0}" Style="{StaticResource MetricValue}" />
                                                <TextBlock Text="во всех таблицах" Style="{StaticResource MutedLabel}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SurfaceCard}" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="ПРОВЕРКА" Style="{StaticResource MutedLabel}" />
                                                <TextBlock Text="{Binding DiagnosticCount, StringFormat=N0}" Style="{StaticResource MetricValue}" />
                                                <TextBlock Text="диагностических сообщений" Style="{StaticResource MutedLabel}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#263A34" CornerRadius="7" Padding="8,4">
                                                        <TextBlock Text="▣  ИСХОДНЫЙ ФАЙЛ · ТОЛЬКО ЧТЕНИЕ" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SourceFileName}" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0" />
                                                <TextBlock Text="{Binding SourceDirectory}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                                                <TextBlock Text="{Binding TextsStatusText}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,7,0,0"
                                                           ToolTip="{Binding TextsPath}" />
                                                <Grid Margin="0,18,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Размер" Style="{StaticResource MutedLabel}" />
                                                    <TextBlock Grid.Column="1" Text="SHA-256" Style="{StaticResource MutedLabel}" />
                                                    <TextBlock Grid.Column="0" Text="{Binding FileLength, Converter={StaticResource FileSizeConverter}}" Margin="0,20,0,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Sha256}" Margin="0,20,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sha256}" />
                                                </Grid>
                                                <Button x:Name="CompareDatabaseButton"
                                                        Style="{StaticResource RoundedButton}"
                                                        Content="≠ Сравнить с другой базой…"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,18,0,0"
                                                        Padding="13,7"
                                                        Click="CompareDatabaseButton_Click"
                                                        ToolTip="Открыть вторую database.res только для чтения и показать различия по таблицам, записям и полям" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="118" Height="118" Margin="24,0,0,0" Background="#242424" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="16">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="▣" FontSize="33" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="LOCKED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Резервные копии RES" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Для каждого подключённого файла показана последняя штатная .bak-копия. Перед восстановлением текущее состояние тоже сохраняется."
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,10" />
                                            <ItemsControl x:Name="ManagedBackupsList" ItemsSource="{Binding ManagedBackups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4,0,0" ToolTip="{Binding BackupToolTip}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="190" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding TypeText}"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding FileName}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding BackupDetails}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasBackup}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Button Grid.Column="3"
                                                                    Style="{StaticResource RoundedButton}"
                                                                    Content="↻ Восстановить"
                                                                    Padding="11,6"
                                                                    Margin="12,0,0,0"
                                                                    Command="{Binding DataContext.RestoreManagedBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Безопасный цикл работы" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="1   Открытие без изменений" Margin="0,15,0,0" />
                                                <TextBlock Text="2   Редактирование доступно сразу" Margin="0,9,0,0" />
                                                <TextBlock Text="3   Просмотр отличий и проверка" Margin="0,9,0,0" />
                                                <TextBlock Text="4   Резервная копия + проверенная запись" Margin="0,9,0,0" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Состояние базы" FontSize="16" FontWeight="SemiBold" />
                                                <Grid Margin="0,15,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Изменений в памяти" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ChangeCount}" FontWeight="SemiBold" />
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Ошибок проверки" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ErrorCount}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Предупреждений" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding WarningCount}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Resources -->
                            <Grid Margin="22,18,22,22"
                                  Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Resources}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="ResourceSearchBox" Style="{StaticResource DarkTextBox}" Text="{Binding ResourceSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,34,8" />
                                        <TextBlock Text="⌕" Foreground="{StaticResource MutedTextBrush}" FontSize="17" Margin="11,0,0,1" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                        <TextBlock Text="Поиск ресурса…" Foreground="{StaticResource SubtleTextBrush}" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResourceSearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{StaticResource RoundedButton}" Command="{Binding ClearResourceSearchCommand}" Content="×" HorizontalAlignment="Right" Width="30" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding ResourceCount, StringFormat={}{0:N0} ресурсов}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Border Grid.Row="2" CornerRadius="10" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <DataGrid x:Name="ResourcesGrid" ItemsSource="{Binding ResourcesView}" BorderThickness="0" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#"
                                                                Binding="{Binding Index}"
                                                                Width="56"
                                                                HeaderStyle="{StaticResource IndexColumnHeaderStyle}"
                                                                CellStyle="{StaticResource IndexColumnCellStyle}"
                                                                ElementStyle="{StaticResource CenteredIndexTextStyle}" />
                                            <DataGridTextColumn Header="Имя ресурса" Binding="{Binding Name}" Width="*" MinWidth="240" />
                                            <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="110" />
                                            <DataGridTextColumn Header="Смещение" Binding="{Binding Offset, StringFormat=N0}" Width="130" />
                                            <DataGridTextColumn Header="Размер" Binding="{Binding Length, Converter={StaticResource FileSizeConverter}}" Width="120" />
                                            <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="160" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>

                            <!-- Full texts.res spreadsheet -->
                            <Grid Margin="22,18,22,22"
                                  Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Texts}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition x:Name="TextsFormulaPaneRow" Height="86" MinHeight="70" MaxHeight="300" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="34" />
