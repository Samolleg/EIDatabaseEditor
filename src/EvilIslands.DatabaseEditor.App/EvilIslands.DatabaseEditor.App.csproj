<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EvilIslands.DatabaseEditor</AssemblyName>
    <RootNamespace>EvilIslands.DatabaseEditor.App</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Product>Редактор БД от Атамана</Product>
    <AssemblyTitle>Редактор БД от Атамана</AssemblyTitle>
    <Description>Редактор database.res и texts.res для «Проклятых Земель»</Description>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Modules.Host/Modules.Host.csproj"/></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EvilIslands.DatabaseEditor.Core\EvilIslands.DatabaseEditor.Core.csproj"
                      Condition="'$(SkipCoreReference)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EvilIslands.DatabaseEditor.UiSmoke" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>
  <ItemGroup><Content Include="..\..\third-party\DirectXTex\*" Link="third-party\DirectXTex\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
