<Application x:Class="EvilIslands.DatabaseEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EvilIslands.DatabaseEditor.App.Infrastructure"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Graphite foundation with restrained bronze/green accents derived from the application icon. -->
            <Color x:Key="WindowColor">#131513</Color>
            <Color x:Key="SidebarColor">#0E100F</Color>
            <Color x:Key="SurfaceColor">#1B1E1C</Color>
            <Color x:Key="SurfaceHoverColor">#232824</Color>
            <Color x:Key="SurfacePressedColor">#2B312D</Color>
            <Color x:Key="BorderColor">#303632</Color>
            <Color x:Key="StrongBorderColor">#465048</Color>
            <Color x:Key="GridLineColor">#292E2A</Color>
            <Color x:Key="RowAlternateColor">#171917</Color>
            <Color x:Key="RowHoverColor">#202521</Color>
            <Color x:Key="RowSelectedColor">#233A2C</Color>
            <Color x:Key="TextColor">#EEF1EC</Color>
            <Color x:Key="MutedTextColor">#AAB2AA</Color>
            <Color x:Key="SubtleTextColor">#778078</Color>

            <!-- Actions and change state. -->
            <Color x:Key="AccentColor">#39B86E</Color>
            <Color x:Key="AccentHoverColor">#4BC77D</Color>
            <Color x:Key="SpreadsheetSelectionColor">#28543A</Color>
            <Color x:Key="ModifiedSurfaceColor">#203B29</Color>
            <Color x:Key="DangerColor">#FF7B86</Color>
            <Color x:Key="DangerSurfaceColor">#3A2025</Color>
            <Color x:Key="WarningColor">#F2C96D</Color>
            <Color x:Key="WarningSurfaceColor">#342B1B</Color>

            <!-- Data source colors are intentionally subtle: sage = database, bronze = texts, amber = raw. -->
            <Color x:Key="DatabaseAccentColor">#AFC1B3</Color>
            <Color x:Key="DatabaseTextColor">#DDE5DE</Color>
            <Color x:Key="DatabaseSurfaceColor">#1A201C</Color>
            <Color x:Key="DatabaseHeaderColor">#202721</Color>
            <Color x:Key="DatabaseBorderColor">#3A4A3D</Color>
            <Color x:Key="LocalizationAccentColor">#C9A66A</Color>
            <Color x:Key="LocalizationTextColor">#E9DFC9</Color>
            <Color x:Key="LocalizationSurfaceColor">#201D18</Color>
            <Color x:Key="LocalizationHeaderColor">#28231B</Color>
            <Color x:Key="LocalizationBorderColor">#57482F</Color>
            <Color x:Key="TechnicalAccentColor">#D7B56A</Color>
            <Color x:Key="TechnicalSurfaceColor">#242017</Color>
            <Color x:Key="TechnicalHeaderColor">#2B251A</Color>

            <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}" />
            <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}" />
            <SolidColorBrush x:Key="RowAlternateBrush" Color="{StaticResource RowAlternateColor}" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
            <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="{StaticResource SubtleTextColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="SpreadsheetSelectionBrush" Color="{StaticResource SpreadsheetSelectionColor}" />
            <SolidColorBrush x:Key="ModifiedSurfaceBrush" Color="{StaticResource ModifiedSurfaceColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
            <SolidColorBrush x:Key="DatabaseAccentBrush" Color="{StaticResource DatabaseAccentColor}" />
            <SolidColorBrush x:Key="DatabaseTextBrush" Color="{StaticResource DatabaseTextColor}" />
            <SolidColorBrush x:Key="DatabaseSurfaceBrush" Color="{StaticResource DatabaseSurfaceColor}" />
            <SolidColorBrush x:Key="DatabaseHeaderBrush" Color="{StaticResource DatabaseHeaderColor}" />
            <SolidColorBrush x:Key="DatabaseBorderBrush" Color="{StaticResource DatabaseBorderColor}" />
            <SolidColorBrush x:Key="LocalizationAccentBrush" Color="{StaticResource LocalizationAccentColor}" />
            <SolidColorBrush x:Key="LocalizationTextBrush" Color="{StaticResource LocalizationTextColor}" />
            <SolidColorBrush x:Key="LocalizationSurfaceBrush" Color="{StaticResource LocalizationSurfaceColor}" />
            <SolidColorBrush x:Key="LocalizationHeaderBrush" Color="{StaticResource LocalizationHeaderColor}" />
            <SolidColorBrush x:Key="LocalizationBorderBrush" Color="{StaticResource LocalizationBorderColor}" />
            <SolidColorBrush x:Key="TechnicalAccentBrush" Color="{StaticResource TechnicalAccentColor}" />
            <SolidColorBrush x:Key="TechnicalSurfaceBrush" Color="{StaticResource TechnicalSurfaceColor}" />
            <SolidColorBrush x:Key="TechnicalHeaderBrush" Color="{StaticResource TechnicalHeaderColor}" />

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:SectionVisibilityConverter x:Key="SectionVisibilityConverter" />
            <converters:FileSizeConverter x:Key="FileSizeConverter" />
            <converters:SeverityBrushConverter x:Key="SeverityBrushConverter" />

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource WindowBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="RoundedButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.76" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="38" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <Style x:Key="SidebarItem" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="8,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="NavBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="3,0,0,0"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="#1D2927" />
                                    <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.36" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#262626" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
                <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="TextBoxBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter TargetName="TextBoxBorder" Property="Background" Value="#242424" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource WindowBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
                <Setter Property="RowBackground" Value="{StaticResource WindowBrush}" />
                <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAlternateBrush}" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserReorderColumns" Value="True" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="EnableColumnVirtualization" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="RowHeight" Value="42" />
                <Setter Property="ColumnHeaderHeight" Value="38" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource SpreadsheetSelectionBrush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
                <Grid Width="10" Background="Transparent">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb MinHeight="28" Margin="2,1">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="ThumbBorder" Background="#565656" CornerRadius="3" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#737373" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#8A8A8A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
                <Grid Height="10" Background="Transparent">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb MinWidth="28" Margin="1,2">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="ThumbBorder" Background="#565656" CornerRadius="3" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#737373" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#8A8A8A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#292E35" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                <Setter Property="Padding" Value="10,7" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
