<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EditorRevision>214</EditorRevision>
    <PlatformTarget>x64</PlatformTarget>
    <VersionPrefix>$(EditorRevision).0.0</VersionPrefix>
    <InformationalVersion Condition="'$(MSBuildProjectName)' != 'ModuleContracts.V1' and '$(MSBuildProjectName)' != 'ModuleContracts.Wpf.V1'">$(EditorRevision)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(MSBuildProjectName)' != 'ModuleContracts.V1' and '$(MSBuildProjectName)' != 'ModuleContracts.Wpf.V1'">false</IncludeSourceRevisionInInformationalVersion>
    <!-- Stable binary binding identity, independent of the product revision. -->
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <FileVersion Condition="'$(MSBuildProjectName)' != 'ModuleContracts.V1' and '$(MSBuildProjectName)' != 'ModuleContracts.Wpf.V1'">$(EditorRevision).0.0.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj-*/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
